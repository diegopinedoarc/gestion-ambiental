rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Dueño original (usuario_ref) O colaborador sumado via invitación
    // (subcolección `establecimientos/{id}/colaboradores`, ver más abajo).
    // El nombre de la función quedó igual para no tocar cada lugar donde ya
    // se usa: ahora significa "es dueño o colaborador", no solo "es dueño".
    function esDuenioDelEstablecimiento(establecimientoId) {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/establecimientos/$(establecimientoId)) &&
        (
          get(/databases/$(database)/documents/establecimientos/$(establecimientoId)).data.usuario_ref == request.auth.uid ||
          exists(/databases/$(database)/documents/establecimientos/$(establecimientoId)/colaboradores/$(request.auth.uid))
        );
    }

    // Hay una invitación pendiente para este establecimiento a este mail.
    // El id del documento en `invitaciones` es siempre
    // `{establecimientoId}__{email}` (armado así para poder chequear que
    // existe sin tener que hacer una consulta por campo, que las reglas de
    // seguridad no permiten).
    function existeInvitacionPendiente(establecimientoId, email) {
      return exists(/databases/$(database)/documents/invitaciones/$(establecimientoId + '__' + email)) &&
        get(/databases/$(database)/documents/invitaciones/$(establecimientoId + '__' + email)).data.estado == 'pendiente';
    }

    // ---- Base normativa: lectura publica, escritura solo admin (se carga via seed o consola) ----
    match /jurisdicciones/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /industrias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /temas_ambientales/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /normativas/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /tramites/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /reglas/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /programas_produccion_limpia/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /factores_emision/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // Catálogo de requisitos ISO 14001/9001 (clausula, descripción, por qué
    // aplica, beneficio). Igual que tramites/reglas, lo cargás vos como admin.
    match /normas_iso/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---- Usuarios: cada uno lee/edita su propio perfil; el admin lee todos ----
    match /usuarios/{uid} {
      allow read: if estaLogueado() && (request.auth.uid == uid || esAdmin());
      allow create: if estaLogueado() && request.auth.uid == uid;
      allow update: if estaLogueado() && (request.auth.uid == uid || esAdmin());
      allow delete: if false;
    }

    // ---- Establecimientos: el dueno y sus colaboradores pueden leer/editar
    // el suyo; admin lee todos. Un invitado con invitación pendiente
    // también puede leerlo (para poder mostrarle a qué empresa se está
    // sumando en /onboarding, antes de aceptar). ----
    match /establecimientos/{id} {
      allow create: if estaLogueado() && request.resource.data.usuario_ref == request.auth.uid;
      allow read: if estaLogueado() &&
        (esDuenioDelEstablecimiento(id) || esAdmin() ||
          existeInvitacionPendiente(id, request.auth.token.email.lower()));
      allow update: if estaLogueado() && (esDuenioDelEstablecimiento(id) || esAdmin());
      allow delete: if false;

      // ---- Colaboradores: quién más (además del dueño) tiene acceso a
      // este establecimiento. Un doc por uid (el id del doc ES el uid), así
      // que solo esa misma persona puede crearlo — y únicamente si tiene
      // una invitación pendiente a su mail. Lo arma /onboarding al aceptar
      // una invitación. ----
      match /colaboradores/{uid} {
        allow read: if estaLogueado() && (esDuenioDelEstablecimiento(id) || esAdmin());
        allow create: if estaLogueado() && request.auth.uid == uid &&
          existeInvitacionPendiente(id, request.auth.token.email.lower());
        allow delete: if estaLogueado() &&
          (
            get(/databases/$(database)/documents/establecimientos/$(id)).data.usuario_ref == request.auth.uid ||
            request.auth.uid == uid ||
            esAdmin()
          );
        allow update: if false;
      }

      // ---- Huella de carbono: un doc por período (año) con el cálculo de
      // emisiones alcance 1/2 (GHG Protocol). Se puede recalcular/sobrescribir
      // el mismo período (por eso permite update, a diferencia de
      // evaluaciones/evidencias), pero no borrar el historial. ----
      match /huella_carbono/{periodo} {
        allow read: if estaLogueado() && (esDuenioDelEstablecimiento(id) || esAdmin());
        allow create: if estaLogueado() && (esDuenioDelEstablecimiento(id) || esAdmin());
        allow update: if estaLogueado() && (esDuenioDelEstablecimiento(id) || esAdmin());
        allow delete: if false;
      }
    }

    // ---- Invitaciones: para sumar a alguien más a un establecimiento sin
    // tener que conocer su uid de antemano (no hay backend propio para
    // buscar usuarios por mail). El id del doc es siempre
    // `{establecimientoId}__{email}`. Cualquier dueño/colaborador de ese
    // establecimiento puede invitar y cancelar; la propia persona invitada
    // puede leer y aceptar la suya buscando por su mail. ----
    match /invitaciones/{invId} {
      allow read: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin() ||
          resource.data.email == request.auth.token.email.lower());
      allow create: if estaLogueado() &&
        (esDuenioDelEstablecimiento(request.resource.data.establecimiento_ref) || esAdmin()) &&
        invId == (request.resource.data.establecimiento_ref + '__' + request.resource.data.email) &&
        request.resource.data.email == request.resource.data.email.lower() &&
        request.resource.data.estado == 'pendiente';
      allow update: if estaLogueado() &&
        resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
        request.resource.data.estado == 'aceptada';
      allow delete: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
    }

    // ---- Cumplimiento: ligado al establecimiento del usuario logueado, o admin ----
    match /cumplimiento/{id} {
      allow read: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow create: if estaLogueado() &&
        (esDuenioDelEstablecimiento(request.resource.data.establecimiento_ref) || esAdmin());
      allow update: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow delete: if false;

      // ---- Historial de evaluaciones de este trámite: mismo dueño que el
      // cumplimiento padre (se mira con un `get()` porque acá no tenemos
      // `resource.data.establecimiento_ref` directamente). Son snapshots que
      // arma `generarChecklist`, nunca se editan ni se borran. ----
      match /evaluaciones/{evId} {
        allow read: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow create: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow update, delete: if false;
      }

      // ---- Evidencias: certificados/constancias que la empresa sube como
      // prueba de que el trámite se cumplió. A diferencia de `evaluaciones`
      // acá sí se puede borrar (si subieron el archivo equivocado, lo
      // borran y suben el correcto), pero no editar el registro. ----
      match /evidencias/{evId} {
        allow read: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow create: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow delete: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow update: if false;
      }
    }

    // ---- Adhesiones a programas de Producción Limpia: mismo criterio de
    // dueño/colaborador que `cumplimiento`, pero son voluntarias (la
    // empresa puede cambiar el estado libremente, incluso "descartar" un
    // programa que no le interesa) y no tienen historial de evaluaciones. ----
    match /adhesiones_pl/{id} {
      allow read: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow create: if estaLogueado() &&
        (esDuenioDelEstablecimiento(request.resource.data.establecimiento_ref) || esAdmin());
      allow update: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow delete: if false;
    }

    // ---- Gestión ISO 14001/9001: un doc por requisito y establecimiento,
    // creado por `sincronizarCumplimientoIso` cuando la empresa elige
    // perseguir una norma. Mismo criterio dueño/colaborador que `cumplimiento`. ----
    match /cumplimiento_iso/{id} {
      allow read: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow create: if estaLogueado() &&
        (esDuenioDelEstablecimiento(request.resource.data.establecimiento_ref) || esAdmin());
      allow update: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow delete: if false;

      // ---- Evidencias de un requisito ISO: mismo patrón que
      // `cumplimiento/{id}/evidencias` (se puede borrar, no editar). ----
      match /evidencias/{evId} {
        allow read: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento_iso/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow create: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento_iso/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow delete: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento_iso/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow update: if false;
      }
    }
  }
}
