rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function esDuenioDelEstablecimiento(establecimientoId) {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/establecimientos/$(establecimientoId)) &&
        get(/databases/$(database)/documents/establecimientos/$(establecimientoId)).data.usuario_ref == request.auth.uid;
    }

    // ---- Base normativa: lectura publica, escritura solo admin (se carga via seed o consola) ----
    match /jurisdicciones/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /industrias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /temas_ambientales/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /normativas/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /tramites/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /reglas/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---- Usuarios: cada uno lee/edita su propio perfil; el admin lee todos ----
    match /usuarios/{uid} {
      allow read: if estaLogueado() && (request.auth.uid == uid || esAdmin());
      allow create: if estaLogueado() && request.auth.uid == uid;
      allow update: if estaLogueado() && (request.auth.uid == uid || esAdmin());
      allow delete: if false;
    }

    // ---- Establecimientos: el dueno puede crear/leer/editar el suyo; admin lee todos ----
    match /establecimientos/{id} {
      allow create: if estaLogueado() && request.resource.data.usuario_ref == request.auth.uid;
      allow read: if estaLogueado() && (resource.data.usuario_ref == request.auth.uid || esAdmin());
      allow update: if estaLogueado() && (resource.data.usuario_ref == request.auth.uid || esAdmin());
      allow delete: if false;
    }

    // ---- Cumplimiento: ligado al establecimiento del usuario logueado, o admin ----
    match /cumplimiento/{id} {
      allow read: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow create: if estaLogueado() &&
        (esDuenioDelEstablecimiento(request.resource.data.establecimiento_ref) || esAdmin());
      allow update: if estaLogueado() &&
        (esDuenioDelEstablecimiento(resource.data.establecimiento_ref) || esAdmin());
      allow delete: if false;

      // ---- Historial de evaluaciones de este trámite: mismo dueño que el
      // cumplimiento padre (se mira con un `get()` porque acá no tenemos
      // `resource.data.establecimiento_ref` directamente). Son snapshots que
      // arma `generarChecklist`, nunca se editan ni se borran. ----
      match /evaluaciones/{evId} {
        allow read: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow create: if estaLogueado() &&
          (esDuenioDelEstablecimiento(
            get(/databases/$(database)/documents/cumplimiento/$(id)).data.establecimiento_ref
          ) || esAdmin());
        allow update, delete: if false;
      }
    }
  }
}
